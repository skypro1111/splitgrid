{
  "manifest_version": 3,
  "name": "SplitGrid Browser Control",
  "version": "1.0.0",
  "description": "Let a SplitGrid agent drive one browser tab you explicitly hand over. Read-only by default, revoked the moment the tab leaves its origin.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "SplitGrid Browser Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": ["tabs", "scripting", "debugger", "storage", "alarms"],
  "optional_host_permissions": ["*://*/*"]
}
